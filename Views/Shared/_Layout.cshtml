<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HomeEase - Trusted home services made easy." />

    <title>@ViewBag.Title - HomeEase</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/HomeEase/style.css")" rel="stylesheet" />

    @RenderSection("pageStyles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light fixed-top home-navbar">
        <div class="container">
            <a class="navbar-brand brand-mark"
               href="@Url.Action("Index", "Home")"
               aria-label="HomeEase home">
                <span class="brand-icon">
                    <i class="bi bi-house-heart-fill"></i>
                </span>
                Home<span>Ease</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNav"
                    aria-controls="mainNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        @Html.ActionLink(
                            "Home", "Index", "Home",
                            null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#services">
                            Services
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#how-it-works">
                            How it works
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#reviews">
                            Reviews
                        </a>
                    </li>

                    @if (Session["UserId"] != null)
                    {
                        <li class="nav-item">
                            @Html.ActionLink(
                                "My Bookings", "MyBookings", "Bookings",
                                null, new { @class = "nav-link" })
                        </li>
                    }
                </ul>

                <div class="nav-actions d-flex align-items-center gap-3">
                    @if (Session["UserId"] == null)
                    {
                        @Html.ActionLink(
                            "Log in", "Login", "Account",
                            null, new { @class = "nav-login" })

                        @Html.ActionLink(
                            "Sign up", "Register", "Account",
                            null, new { @class = "nav-login d-none d-xl-inline" })
                    }
                    else
                    {
                        <span class="nav-login">
                            Hi, @Session["FullName"]
                        </span>

                        using (Html.BeginForm(
                            "Logout", "Account", FormMethod.Post,
                            new { @class = "d-inline" }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-link nav-login text-decoration-none p-0">
                                Logout
                            </button>
                        }
                    }

                    <a class="btn btn-brand btn-sm px-4 py-2"
                       href="@Url.Action("Index", "Home")#services">
                        Book a service
                        <i class="bi bi-arrow-up-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="homeease-main">
        @RenderBody()
    </main>


    <footer class="homeease-footer">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h3 class="footer-brand">HomeEase</h3>
                    <p>
                        Your trusted partner for cleaning,
                        repairs and everyday home services.
                    </p>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5>Quick Links</h5>
                    <ul class="footer-links">
                        <li>@Html.ActionLink("Home", "Index", "Home")</li>
                        <li><a href="@Url.Action("Index", "Services")">Services</a></li>
                        <li>@Html.ActionLink("Contact", "Contact", "Home")</li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Our Services</h5>
                    <ul class="footer-links">
                        <li>Home Cleaning</li>
                        <li>Plumbing</li>
                        <li>Electrical Repairs</li>
                        <li>Laundry & Ironing</li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Contact</h5>
                    <p>Professional home services, made simple.</p>
                    <a href="@Url.Action("Contact", "Home")">Contact Us</a>
                </div>
            </div>

            <hr />

            <div class="text-center">
                <p class="mb-0">
                    &copy; @DateTime.Now.Year HomeEase.
                    All rights reserved.
                </p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="@Url.Content("~/Scripts/HomeEase/main.js")"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
