
@model HomeEase.Models.AdminStaffViewModel

@{
    ViewBag.Title = "Edit Staff";
}

<div class="container py-5" style="max-width: 750px;">
    <h2 class="mb-4">Edit Staff</h2>

    @using (Html.BeginForm("EditStaff", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)
        @Html.HiddenFor(m => m.StaffProfileId)

        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

        <div class="mb-3">
            @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.FullName,
                new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Email,
                new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Phone,
                new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Skills, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Skills, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Skills, "",
                new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.ExperienceYears, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.ExperienceYears,
                new { @class = "form-control", type = "number", min = "0", max = "50" })
            @Html.ValidationMessageFor(m => m.ExperienceYears, "",
                new { @class = "text-danger" })
        </div>

        <div class="form-check mb-3">
            @Html.CheckBoxFor(m => m.IsAvailable,
                new { @class = "form-check-input" })
            @Html.LabelFor(m => m.IsAvailable, "Available for bookings",
                new { @class = "form-check-label" })
        </div>

        <div class="form-check mb-4">
            @Html.CheckBoxFor(m => m.IsActive,
                new { @class = "form-check-input" })
            @Html.LabelFor(m => m.IsActive, "Staff account active",
                new { @class = "form-check-label" })
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>

        @Html.ActionLink("Cancel", "ManageStaff", "Admin",
            null, new { @class = "btn btn-outline-secondary ms-2" })
    }
</div>
