@model IEnumerable<HomeEase.Models.AdminServiceViewModel>

@{
    ViewBag.Title = "Manage Services";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Services</h2>
            <p class="text-muted mb-0">
                Add, edit and deactivate HomeEase services.
            </p>
        </div>

        @Html.ActionLink("Add New Service", "CreateService", "Admin",
            null, new { @class = "btn btn-primary" })
    </div>

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["AdminMessage"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Service</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in Model)
                {
                    <tr>
                        <td>@service.ServiceId</td>
                        <td>@service.ServiceName</td>
                        <td>@service.Category</td>
                        <td>₹@service.Price.ToString("N2")</td>
                        <td>@service.DurationMinutes min</td>
                        <td>
                            @if (service.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            @Html.ActionLink("Edit", "EditService", "Admin",
                                new { id = service.ServiceId },
                                new { @class = "btn btn-sm btn-outline-primary" })

                            @if (service.IsActive)
                            {
                                using (Html.BeginForm("DeactivateService", "Admin",
                                    new { id = service.ServiceId },
                                    FormMethod.Post,
                                    new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Deactivate this service?');">
                                        Deactivate
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @Html.ActionLink("Back to Admin Dashboard", "Index", "Admin",
        null, new { @class = "btn btn-outline-secondary mt-3" })
</div>