
@model HomeEase.Models.ReviewViewModel

@{
    ViewBag.Title = "Write a Review";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    <h2 class="mb-2">Write a Review</h2>
                    <p class="text-muted mb-4">
                        Share your experience with our service.
                    </p>

                    <h5 class="mb-4">@Model.ServiceName</h5>

                    @using (Html.BeginForm("CreateReview", "Bookings",
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.BookingId)

                        @Html.ValidationSummary(
                            false, "", new { @class = "text-danger mb-3" })

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Your Rating
                            </label>

                            <div class="d-flex flex-wrap gap-3">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <label class="form-check">
                                        @Html.RadioButtonFor(
                                            m => m.Rating, i,
                                            new { @class = "form-check-input" })
                                        <span class="form-check-label">
                                            @i ★
                                        </span>
                                    </label>
                                }
                            </div>

                            @Html.ValidationMessageFor(
                                m => m.Rating, "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(
                                m => m.Comment,
                                new { @class = "form-label fw-semibold" })

                            @Html.TextAreaFor(
                                m => m.Comment,
                                new
                                {
                                    @class = "form-control",
                                    rows = "4",
                                    maxlength = "500",
                                    placeholder = "Tell us about your experience (optional)"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Comment, "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Submit Review
                            </button>

                            @Html.ActionLink(
                                "Cancel",
                                "MyBookings",
                                "Bookings",
                                null,
                                new { @class = "btn btn-outline-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
