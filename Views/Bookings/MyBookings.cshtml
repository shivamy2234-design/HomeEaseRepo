
@model IEnumerable<HomeEase.Models.BookingHistoryViewModel>
@using System.Linq;

@{
    ViewBag.Title = "My Bookings";
}

<div class="container py-5">
    <h2 class="mb-2">My Bookings</h2>
    <p class="text-muted mb-4">
        View your booking history and track service status.
    </p>

    @if (TempData["ReviewMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["ReviewMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No bookings found</h5>
                <p class="text-muted">
                    You haven't booked any services yet.
                </p>

                @Html.ActionLink(
                    "Browse Services",
                    "Index",
                    "Services",
                    null,
                    new { @class = "btn btn-primary" })
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Booking ID</th>
                        <th>Service</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Review</th>
                        <th>Payment</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>#@booking.BookingId</td>
                            <td>@booking.ServiceName</td>
                            <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                            <td>@booking.TimeSlot</td>
                            <td>₹@booking.TotalAmount.ToString("N2")</td>

                            <td>
                                @if (booking.Status == "Completed")
                                {
                                    <span class="badge bg-success">
                                        @booking.Status
                                    </span>
                                }
                                else if (booking.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        @booking.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @booking.Status
                                    </span>
                                }
                            </td>

                            <td>
                                @if (booking.Status == "Completed"
                                    && !booking.HasReview)
                                {
                                    @Html.ActionLink(
                                        "Write Review",
                                        "CreateReview",
                                        "Bookings",
                                        new { id = booking.BookingId },
                                        new { @class = "btn btn-sm btn-primary" })
                                }
                                else if (booking.HasReview)
                                {
                                    <span class="badge bg-success">
                                        Reviewed
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>


                            <td>
                                @if (booking.HasPaid)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else if (booking.Status == "Cancelled")
                                {
                                    <span class="text-muted">Not payable</span>
                                }
                                else
                                {
                                    @Html.ActionLink(
                                        "Pay Now",
                                        "Pay",
                                        "Payments",
                                        new { id = booking.BookingId },
                                        new { @class = "btn btn-sm btn-success" })
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink(
            "Back to Dashboard",
            "Dashboard",
            "Account",
            null,
            new { @class = "btn btn-outline-primary" })
    </div>
</div>
