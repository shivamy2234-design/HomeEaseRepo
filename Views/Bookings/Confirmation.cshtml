@{
    ViewBag.Title = "Booking Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm text-center">
                <div class="card-body p-4">

                    <h1 class="text-success mb-3">
                        Booking Submitted!
                    </h1>

                    <p class="text-muted">
                        @TempData["BookingMessage"]
                    </p>

                    <hr />

                    <h5>Booking Reference</h5>
                    <h3>#@ViewBag.BookingId</h3>

                    <p class="mt-4 mb-1">
                        <strong>Service:</strong> @ViewBag.ServiceName
                    </p>

                    <p class="mb-1">
                        <strong>Date:</strong> @ViewBag.BookingDate
                    </p>

                    <p class="mb-1">
                        <strong>Time:</strong> @ViewBag.TimeSlot
                    </p>

                    <p class="mb-1">
                        <strong>Amount:</strong>
                        ₹@(((decimal)ViewBag.TotalAmount).ToString("N2"))
                    </p>

                    <p class="mb-4">
                        <strong>Status:</strong>
                        <span class="badge bg-warning text-dark">
                            @ViewBag.Status
                        </span>
                    </p>

                    @Html.ActionLink("Browse Services",
                        "Index", "Services",
                        null, new { @class = "btn btn-primary" })

                    @Html.ActionLink("My Dashboard",
                        "Dashboard", "Account",
                        null, new { @class = "btn btn-outline-secondary ms-2" })

                </div>
            </div>

        </div>
    </div>
</div>
