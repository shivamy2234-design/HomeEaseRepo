
@model List<HomeEase.Models.ServiceViewModel>

@{
    ViewBag.Title = "Our Services | HomeEase";

    var categories = ViewBag.Categories as List<string>
                     ?? new List<string>();

    string selectedCategory = ViewBag.SelectedCategory as string;
}

<main class="page-main">

    <section class="page-hero">
        <div class="container">
            <div class="eyebrow">WHAT WE CAN HELP WITH</div>
            <h1>Care for your home, <span>all in one place.</span></h1>
            <p class="page-intro">
                Browse our home services, compare prices and book a convenient time.
            </p>
        </div>
    </section>

    <section class="section-pad services-section">
        <div class="container">

            <div class="section-heading d-flex flex-column flex-md-row
                        align-items-md-end justify-content-between gap-3">
                <div>
                    <div class="eyebrow">HOME SERVICES</div>
                    <h2>Find the right help <span>for your home.</span></h2>
                </div>

                <p>Choose a service that fits your needs and budget.</p>
            </div>

            <!-- Category filter -->
            <div class="d-flex flex-wrap gap-2 mt-4 mb-3">
                <a href="@Url.Action("Index", "Services")"
                   class="btn @(string.IsNullOrEmpty(selectedCategory) ? "btn-brand" : "btn-outline-brand")">
                    All Services
                </a>

                @foreach (string category in categories)
                {
                    <a href="@Url.Action("Index", "Services", new { category = category })"
                       class="btn @(string.Equals(selectedCategory, category, StringComparison.OrdinalIgnoreCase) ? "btn-brand" : "btn-outline-brand")">
                        @category
                    </a>
                }
            </div>

            <!-- Dynamic service cards -->
            <div class="row g-4 mt-2">

                @if (Model != null && Model.Count > 0)
                {
                    foreach (var service in Model)
                    {
                        string imageUrl = "https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=800&q=80";
                        string iconClass = "bi-stars";

                        string serviceName = (service.ServiceName ?? "").ToLowerInvariant();
                        string serviceCategory = (service.Category ?? "").ToLowerInvariant();

                        if (serviceName.Contains("kitchen") ||
                            serviceName.Contains("bathroom"))
                        {
                            imageUrl = "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=800&q=80";
                            iconClass = "bi-droplet-half";
                        }
                        else if (serviceCategory.Contains("electrical") ||
                                 serviceName.Contains("electrical"))
                        {
                            imageUrl = "https://images.unsplash.com/photo-1621905251918-48416bd8575a?auto=format&fit=crop&w=800&q=80";
                            iconClass = "bi-lightning-charge";
                        }
                        else if (serviceCategory.Contains("plumbing") ||
                                 serviceName.Contains("plumbing"))
                        {
                            imageUrl = "https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?auto=format&fit=crop&w=800&q=80";
                            iconClass = "bi-wrench-adjustable";
                        }
                        else if (serviceName.Contains("laundry") ||
                                 serviceName.Contains("ironing"))
                        {
                            imageUrl = "https://images.unsplash.com/photo-1527515637462-cff94eecc1ac?auto=format&fit=crop&w=800&q=80";
                            iconClass = "bi-basket2";
                        }
                        else if (serviceName.Contains("ac") ||
                                 serviceName.Contains("appliance"))
                        {
                            imageUrl = "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80";
                            iconClass = "bi-house-gear";
                        }

                        <div class="col-sm-6 col-lg-4">
                            <article class="service-card">

                                <div class="service-image">
                                    <img src="@imageUrl"
                                         alt="@service.ServiceName"
                                         loading="lazy" />

                                    <span class="service-tag">
                                        @service.Category
                                    </span>
                                </div>

                                <div class="service-content">
                                    <div class="service-icon">
                                        <i class="bi @iconClass"></i>
                                    </div>

                                    <h3>@service.ServiceName</h3>

                                    <p>
                                        @(string.IsNullOrWhiteSpace(service.Description)
                                            ? "Professional home service tailored to your needs."
                                            : service.Description)
                                    </p>

                                    <div class="service-bottom">
                                        <span>
                                            Starting at
                                            <strong>₹@service.Price.ToString("N0")</strong>
                                        </span>

                                        <a href="@Url.Action("Details", "Services", new { id = service.ServiceId })"
                                           class="service-link"
                                           aria-label="View details for @service.ServiceName">
                                            <i class="bi bi-arrow-up-right"></i>
                                        </a>
                                    </div>

                                    <a href="@Url.Action("Create", "Bookings", new { serviceId = service.ServiceId })"
                                       class="btn btn-brand w-100 mt-3">
                                        Book Now
                                        <i class="bi bi-arrow-right ms-2"></i>
                                    </a>

                                </div>
                            </article>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-5">
                            <i class="bi bi-search fs-1"></i>
                            <h3 class="mt-3">No services found</h3>
                            <p class="text-secondary">
                                No active services are available in this category.
                            </p>

                            <a href="@Url.Action("Index", "Services")"
                               class="btn btn-outline-brand">
                                View all services
                            </a>

                            @foreach (var service in Model)
                            {
                                <div class="col-sm-6 col-lg-4">
                                    <article class="service-card">
                                        <div class="service-content">
                                            <h3>@service.ServiceName</h3>

                                            <p>@service.Description</p>

                                            <div class="service-bottom">
                                                <span>
                                                    Starting at
                                                    <strong>₹@service.Price.ToString("N0")</strong>
                                                </span>

                                                <a href="@Url.Action(
                        "Details",
                        "Services",
                        new { id = service.ServiceId })"
                                                   class="service-link">
                                                    <i class="bi bi-arrow-up-right"></i>
                                                </a>
                                            </div>

                                            <a href="@Url.Action(
                    "Create",
                    "Bookings",
                    new { serviceId = service.ServiceId })"
                                               class="btn btn-brand w-100 mt-3">
                                                Book Now
                                            </a>
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>

        </div>
    </section>

</main>
