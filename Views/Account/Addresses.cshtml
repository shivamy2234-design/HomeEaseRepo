
@model IEnumerable<HomeEase.Models.AddressViewModel>

@{
    ViewBag.Title = "My Addresses";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Addresses</h2>

        @Html.ActionLink(
            "My Profile",
            "Profile",
            "Account",
            null,
            new { @class = "btn btn-outline-primary" })
    </div>

    @if (TempData["AddressMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["AddressMessage"]
        </div>
    }

    @if (TempData["AddressError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["AddressError"]
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-7">
            <h4 class="mb-3">Saved Addresses</h4>

            @if (Model != null && Model.Any())
            {
                foreach (var address in Model)
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-body">

                            <div class="d-flex justify-content-between">
                                <h5>Address</h5>

                                @if (address.IsDefault)
                                {
                                    <span class="badge bg-success">
                                        Default
                                    </span>
                                }
                            </div>

                            <p class="mb-1">@address.AddressLine</p>
                            <p class="mb-1">
                                @address.City, @address.State
                            </p>
                            <p class="mb-0">
                                PIN: @address.PostalCode
                            </p>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    You have not saved any addresses yet.
                </div>
            }
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add New Address</h4>
                </div>

                <div class="card-body">

                    @using (Html.BeginForm("AddAddress", "Account",
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label" for="AddressLine">Address</label>

                            <input type="text"
                                   name="AddressLine"
                                   class="form-control"
                                   maxlength="200"
                                   required
                                   placeholder="House no., street, locality" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="City">City</label>
                            <input type="text" name="City" id="City"
                                   class="form-control" maxlength="100"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="State">State</label>
                            <input type="text" name="State" id="State"
                                   class="form-control" maxlength="100"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="PostalCode">
                                PIN Code
                            </label>
                            <input type="text" name="PostalCode" id="PostalCode"
                                   class="form-control"
                                   pattern="[0-9]{6}"
                                   maxlength="6"
                                   inputmode="numeric"
                                   title="Enter a valid 6-digit PIN code"
                                   required />
                        </div>

                        <div class="form-check mb-3">
                            <input type="checkbox" name="IsDefault"
                                   value="true" id="IsDefault"
                                   class="form-check-input" />

                            <input type="hidden" name="IsDefault"
                                   value="false" />

                            <label class="form-check-label" for="IsDefault">
                                Set as default address
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Save Address
                        </button>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
