
@model HomeEase.Models.RegisterViewModel

@{
    ViewBag.Title = "Create account | HomeEase";
}

<main class="auth-wrap">
    <section class="auth-card">

        <div class="auth-symbol">
            <i class="bi bi-person-plus"></i>
        </div>

        <p class="eyebrow text-center">GET STARTED</p>

        <h1>Create your account</h1>

        <p class="auth-subtitle">
            Book reliable home services with ease.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["SuccessMessage"]
            </div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                false,
                "",
                new { @class = "alert alert-danger" }
            )

            <div class="mb-3">
                @Html.LabelFor(
                    m => m.FullName,
                    "Full name",
                    new { @class = "form-label" }
                )

                @Html.TextBoxFor(m => m.FullName, new
                {
                    @class = "form-control",
                    autocomplete = "name",
                    placeholder = "Your full name"
                })

                @Html.ValidationMessageFor(
                    m => m.FullName,
                    "",
                    new { @class = "text-danger small" }
                )
            </div>

            <div class="mb-3">
                @Html.LabelFor(
                    m => m.Email,
                    "Email address",
                    new { @class = "form-label" }
                )

                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    type = "email",
                    autocomplete = "email",
                    placeholder = "you@example.com"
                })

                @Html.ValidationMessageFor(
                    m => m.Email,
                    "",
                    new { @class = "text-danger small" }
                )
            </div>

            <div class="mb-3">
                @Html.LabelFor(
                    m => m.Phone,
                    "Phone number",
                    new { @class = "form-label" }
                )

                @Html.TextBoxFor(m => m.Phone, new
                {
                    @class = "form-control",
                    type = "tel",
                    autocomplete = "tel",
                    inputmode = "numeric",
                    placeholder = "10-digit mobile number"
                })

                @Html.ValidationMessageFor(
                    m => m.Phone,
                    "",
                    new { @class = "text-danger small" }
                )
            </div>

            <div class="mb-3">
                @Html.LabelFor(
                    m => m.Password,
                    "Password",
                    new { @class = "form-label" }
                )

                @Html.PasswordFor(m => m.Password, new
                {
                    @class = "form-control",
                    autocomplete = "new-password",
                    placeholder = "At least 8 characters"
                })

                @Html.ValidationMessageFor(
                    m => m.Password,
                    "",
                    new { @class = "text-danger small" }
                )
            </div>

            <div class="mb-3">
                @Html.LabelFor(
                    m => m.ConfirmPassword,
                    "Confirm password",
                    new { @class = "form-label" }
                )

                @Html.PasswordFor(m => m.ConfirmPassword, new
                {
                    @class = "form-control",
                    autocomplete = "new-password",
                    placeholder = "Enter password again"
                })

                @Html.ValidationMessageFor(
                    m => m.ConfirmPassword,
                    "",
                    new { @class = "text-danger small" }
                )
            </div>

            <button class="btn btn-brand w-100 py-2" type="submit">
                Create account
                <i class="bi bi-arrow-right ms-1"></i>
            </button>
        }

        <p class="auth-switch">
            Already have an account?
            @Html.ActionLink("Log in", "Login", "Account")
        </p>

    </section>
</main>
